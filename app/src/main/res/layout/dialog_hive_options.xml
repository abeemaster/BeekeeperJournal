<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:text="@string/hive_options"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/editNumberCard"
        style="@style/Widget.BeekeeperJournal.DialogOptionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/editNumberText"
            style="@style/Widget.BeekeeperJournal.DialogCompoundOption"
            android:text="@string/edit_number"
            android:contentDescription="@string/edit_number"
            app:drawableStartCompat="@drawable/ic_edit" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/selectPrimaryColorCard"
        style="@style/Widget.BeekeeperJournal.DialogOptionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/selectPrimaryColorText"
            style="@style/Widget.BeekeeperJournal.DialogCompoundOption"
            android:text="@string/select_base_color"
            android:contentDescription="@string/select_base_color"
            app:drawableStartCompat="@drawable/ic_color_lens" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/selectSecondaryColorCard"
        style="@style/Widget.BeekeeperJournal.DialogOptionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/selectSecondaryColorText"
            style="@style/Widget.BeekeeperJournal.DialogCompoundOption"
            android:text="@string/select_additional_color"
            android:contentDescription="@string/select_additional_color"
            app:drawableStartCompat="@drawable/ic_color_lens" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/deleteHiveCard"
        style="@style/Widget.BeekeeperJournal.DialogOptionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/holo_red_light">

        <TextView
            android:id="@+id/deleteHiveCardText"
            style="@style/Widget.BeekeeperJournal.DialogCompoundOption"
            android:text="@string/delete_hive"
            android:contentDescription="@string/delete_hive"
            app:drawableStartCompat="@drawable/ic_delete" />
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
