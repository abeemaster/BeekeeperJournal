<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/yearItemLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_medium"
    android:paddingTop="@dimen/spacing_small"
    android:paddingEnd="@dimen/spacing_medium"
    android:paddingBottom="@dimen/spacing_small"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <!-- Іконка року (можна використовувати іконку календаря) -->
    <ImageView
        android:id="@+id/yearIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_calendar_month"
        android:contentDescription="@string/cd_year_icon"
        android:layout_marginEnd="@dimen/spacing_medium"
        app:tint="@color/color_primary_dark" />

    <!-- Рік (наприклад, 2025) -->
    <TextView
        android:id="@+id/yearTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
        android:textStyle="bold"
        android:textColor="@color/black"
        tools:text="2025" />

    <!-- Мітка "АКТИВНИЙ" -->
    <TextView
        android:id="@+id/activeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_active"
        android:visibility="gone"
        tools:visibility="visible"
        android:layout_marginEnd="@dimen/spacing_medium"
        android:paddingStart="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_small"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@color/color_primary_darker"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_small"
        android:textStyle="bold"/>

    <!-- Кнопка "Перемкнути" (для неактивних років) -->
    <Button
        android:id="@+id/switchButton"
        style="@style/Widget.AppCompat.Button.Borderless.Colored"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/action_switch_year"
        android:visibility="gone"
        tools:visibility="visible"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_small"/>

</LinearLayout>