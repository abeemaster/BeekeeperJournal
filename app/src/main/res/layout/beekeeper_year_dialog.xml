<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <!-- Заголовок діалогу -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_beekeeper_year_title"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:layout_marginBottom="@dimen/spacing_medium"/>

    <!-- Елемент для відображення поточного активного року -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/notes_area_background"
        android:padding="@dimen/spacing_medium"
        android:layout_marginBottom="@dimen/spacing_small">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_current_year"
            android:textSize="14sp"
            android:textStyle="italic"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginEnd="@dimen/spacing_small"/>

        <TextView
            android:id="@+id/currentYearTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="N/A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorAccent"
            tools:text="2025 (Активний)"/>
    </LinearLayout>


    <!-- Список доступних років -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/yearsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="300dp"
        android:layout_marginTop="@dimen/spacing_medium"
        android:layout_marginBottom="@dimen/spacing_medium"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="4"
        tools:listitem="@layout/item_beekeeper_year" />

    <!-- Кнопка для додавання нового року -->
    <Button
        android:id="@+id/addYearButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/action_add_year"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        style="@style/Widget.App.Button.NewEntry"
        android:textColor="@color/white"
        android:backgroundTint="?attr/colorPrimary"
        android:layout_marginTop="@dimen/spacing_medium" />

</LinearLayout>