<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Заголовок, який відображатиме "Завантаження..." або "Розпакування..." -->
    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_vosk_download_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:gravity="center_horizontal" />

    <!-- Індикатор прогресу (стрічка, що рухається) -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="0"
        android:layout_marginBottom="8dp"/>

    <!-- Текст для відображення відсотків (наприклад, 45%) -->
    <TextView
        android:id="@+id/progressTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_progress_value"
        android:gravity="center_horizontal"
        android:textSize="14sp"/>

    <!-- Додатковий опис, що процес триває -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_vosk_progress_description"
        android:gravity="center_horizontal"
        android:textSize="12sp"
        android:layout_marginTop="16dp"/>
</LinearLayout>