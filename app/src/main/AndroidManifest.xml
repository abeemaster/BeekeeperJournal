<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>

    <!-- НОВИЙ ДОЗВІЛ, ПОТРІБНИЙ ДЛЯ ANDROID 13+ (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>


    <application
        android:name=".BeekeeperApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BeekeeperJournal"
        tools:targetApi="31">
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.HiveInfoActivity"
            android:exported="false"
            android:label="Інформація про Вулик"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BeekeeperJournal"
            tools:ignore="DiscouragedApi" />
        <activity
            android:name=".activities.NoteActivity"
            android:exported="false"
            android:label="Редагувати Запис"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi" />
        <activity
            android:name=".activities.SearchActivity"
            android:exported="false"
            android:label="Пошук"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi" /> <!-- ДОДАНО SearchActivity -->
        <activity
            android:name=".activities.ProfitabilityActivity"
            android:exported="false"
            android:label="Рентабельність пасіки"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BeekeeperJournal"
            tools:ignore="DiscouragedApi" />
        <activity
            android:name=".activities.VoiceSettingsActivity"
            android:label="Налаштування"
            android:screenOrientation="unspecified"
            tools:ignore="DiscouragedApi" />

        <activity android:name=".activities.SettingsActivity"
            android:label="@string/title_settings" />

    </application>

</manifest>

